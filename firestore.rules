rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    match /contact_messages/{messageId} {
      allow read: if false; // Accessible uniquement aux administrateurs via console/backend
      allow create: if request.resource.data.keys().hasAll(['fullName', 'email', 'profileType', 'message', 'createdAt'])
        && isValidString(request.resource.data.fullName, 1, 150)
        && isValidString(request.resource.data.email, 3, 200)
        && isValidString(request.resource.data.message, 1, 5000);
      allow update, delete: if false;
    }

    match /candidacies/{candidacyId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasAll(['fullName', 'email', 'createdAt'])
        && isValidString(request.resource.data.fullName, 1, 150)
        && isValidString(request.resource.data.email, 3, 200);
      allow update, delete: if false;
    }
  }
}
